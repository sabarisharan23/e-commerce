generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Vendor {
  id           String   @id @default(cuid())
  vendorCode   String   @unique
  name         String
  email        String   @unique
  passwordHash String
  status       String   @default("FRESH_ONBOARD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("vendors")
}

model Product {
  id               String   @id @default(cuid())
  productCode      String   @unique
  sku              String   @unique
  slug             String   @unique
  name             String
  shortDescription String
  description      String
  categoryId       String?
  tagId            String?
  category         String
  categoryTag      String
  imageSrc         String
  imageAlt         String
  price            Decimal  @db.Decimal(10, 2)
  originalPrice    Decimal? @db.Decimal(10, 2)
  rating           Float    @default(0)
  saleLabel        String?
  stockUnits       Int      @default(0)
  status           String   @default("IN_STOCK")
  weight           String
  highlights       Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  categoryRef      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tagRef           ProductTag? @relation(fields: [tagId], references: [id], onDelete: SetNull)

  @@map("products")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

model ProductTag {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("product_tags")
}
